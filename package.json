{
  "name": "careconnect-root",
  "version": "1.0.0",
  "description": "CareConnect Hospital & Appointment Management System - Root Runner",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "cd backend && mvnw.cmd spring-boot:run",
    "frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd frontend && npm install",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
