# ==============================================================================
# CareConnect Frontend - Environment Variables Template
# Copy this file to '.env' and fill in your actual values.
# In Vite, all client variables MUST start with 'VITE_'
# ==============================================================================

# REST API Base URL
# For local development with Vite proxy:
VITE_API_BASE_URL=/api

# For production deployment (example: deployed Spring Boot server):
# VITE_API_BASE_URL=https://your-api-domain.com/api

# Application Title
VITE_APP_TITLE=CareConnect - Hospital Management System
